        "html": "<div style=\"text-align: center;\">\n  <div class=\"box\" id=\"htmlgraphics-text\"> OFF </div>\n</div>\n",
        "onInit": "\n\n\n",
        "onInitOnResize": true,
        "onRender": "// Sets the value from the first series on every refresh\nconst htmlgraphics = htmlNode.getElementById('htmlgraphics-text');\n\nif (htmlgraphics) {\n  values =  data.series[0]?.fields[0].values\n  const status = values[values.length -1];\n  htmlgraphics.textContent = status;\n\n  if (status === 'DESACTIVED') {\n        htmlgraphics.classList.remove('activate')\n  } \n  \n  else if(status === 'ACTIVED'){\n    htmlgraphics.classList.add('activate')\n  }\n  \n  else {\n    htmlgraphics.classList.add('error')\n  }\n}\n",
        "overflow": "visible",
        "panelupdateOnMount": false,
